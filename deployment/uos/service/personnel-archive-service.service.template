[Unit]
Description=人员档案数据服务
Documentation=file:/opt/personnel-archive-service/log/
Wants=network-online.target
After=network-online.target mysql.service mysqld.service
ConditionPathIsReadWrite=/opt/personnel-archive-service/log
ConditionPathExists=/opt/personnel-archive-service/personnel-archive-service.jar
ConditionPathExists=/etc/personnel-archive-service/personnel-archive-service.env

[Service]
Type=simple
User=personnel-archive
Group=personnel-archive
WorkingDirectory=/opt/personnel-archive-service
EnvironmentFile=/etc/personnel-archive-service/personnel-archive-service.env
ExecStart=@JAVA_BIN@ -jar /opt/personnel-archive-service/personnel-archive-service.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/opt/personnel-archive-service/log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=personnel-archive-service

[Install]
WantedBy=multi-user.target
